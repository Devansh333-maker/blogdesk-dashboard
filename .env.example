# One aggregator webhook can return a `variations` array. Each variation contains
# id, name, group, total, published, processing, helper, color, and records.
# Each record can include title, status, publishedAt, url, progress, and workflow.
# The server normalizes n8n status `publish` (plus legacy published values) to `Published`.
N8N_BLOGS_WEBHOOK_URL=
N8N_ANALYTICS_WEBHOOK_URL=
N8N_OPENAI_COSTS_WEBHOOK_URL=
N8N_TIME_SAVED_WEBHOOK_URL=
N8N_CREATION_TIMINGS_WEBHOOK_URL=

# Or connect System 1, Circuit, and Market workflows independently. These must
# be read-only n8n webhook/API endpoints that return current rows, not browser UI URLs.
N8N_SYSTEM1_WEBHOOK_URL=
N8N_CIRCUIT_BLOGS_WEBHOOK_URL=
N8N_MARKET_BLOGS_WEBHOOK_URL=

# Optional bearer token used only by the server-side proxy.
N8N_BLOGS_API_KEY=

# Cost Analysis security. Set these only as encrypted production runtime
# secrets. Never use NEXT_PUBLIC_ names and never commit real values.
COST_ADMIN_PASSWORD_HASH=
COST_ADMIN_PASSWORD_SALT=
COST_ADMIN_PASSWORD_ITERATIONS=600000
COST_AUTH_SESSION_SECRET=
COST_IP_HASH_SECRET=
OPENAI_KEY_ENCRYPTION_KEY=

